<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="AutomationExercise Suite" verbose="1">
  <parameter name="browser" value="chrome"/>
  <listeners>
    <listener class-name="utils.SuiteListener"/>
  </listeners>
  <test thread-count="1" name="Regression Tests">
    <classes>
      <class name="tests.RegisterUserTest"/>
      <class name="tests.LoginCorrectTest"/>
      <class name="tests.LoginIncorrectTest"/>
      <class name="tests.LogoutUserTest"/>
      <class name="tests.RegisterExistingEmailTest"/>
      <class name="tests.ContactUsTest"/>
      <class name="tests.TestCasesPageTest"/>
      <class name="tests.VerifyProductsTest"/>
      <class name="tests.SearchProductTest"/>
      <class name="tests.VerifySubscriptionTest"/>
      <class name="tests.VerifySubscriptionCartTest"/>
    </classes>
  </test>
</suite>